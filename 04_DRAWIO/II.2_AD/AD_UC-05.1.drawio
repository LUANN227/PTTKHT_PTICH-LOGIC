<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-05.1" name="AD UC-05.1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;RM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="628" height="34" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="628" height="1690" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="648" y="20" width="412" height="34" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="648" y="54" width="412" height="1690" as="geometry"/></mxCell><mxCell id="n6" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="231" y="72" width="26" height="26" as="geometry"/></mxCell><mxCell id="n7" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="232" y="153" width="24" height="24" as="geometry"/></mxCell><mxCell id="n8" value="1. Tiếp nhận nhu cầu đã xác nhận và ứng viên còn khả năng tham gia; xác định vị trí cần bố trí" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="123" y="242" width="242" height="56" as="geometry"/></mxCell><mxCell id="n9" value="2. Hiển thị theo vị trí: nhu cầu, ứng viên, kết luận khả năng tham gia (V5)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="728" y="243" width="251" height="54" as="geometry"/></mxCell><mxCell id="n10" value="3. Tra cứu hồ sơ năng lực, mức sử dụng, lịch phân bổ, nguồn cung còn lại" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="123" y="363" width="242" height="54" as="geometry"/></mxCell><mxCell id="n11" value="4. Cung cấp thông tin; so sánh mức phù hợp, mức sử dụng, chi phí khi nhiều ứng viên đạt" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="728" y="362" width="251" height="56" as="geometry"/></mxCell><mxCell id="n12" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="232" y="453" width="24" height="24" as="geometry"/></mxCell><mxCell id="n13" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="232" y="543" width="24" height="24" as="geometry"/></mxCell><mxCell id="n14" value="A3. Lập phương án “chấp nhận một phần”, ghi mức thiếu hụt" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="419" y="528" width="215" height="54" as="geometry"/></mxCell><mxCell id="n15" value="5. Xây dựng phương án chính: chọn người, vai trò, tỷ lệ, thời gian theo giai đoạn" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="123" y="638" width="242" height="54" as="geometry"/></mxCell><mxCell id="n16" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="232" y="743" width="24" height="24" as="geometry"/></mxCell><mxCell id="n17" value="6. Lưu phương án, trạng thái “đang xây dựng” (bắt đầu tính hạn 3 ngày làm việc)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="728" y="808" width="251" height="54" as="geometry"/></mxCell><mxCell id="n18" value="7. Nhận biết vị trí rủi ro cao (chỉ một ứng viên đạt)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="728" y="898" width="251" height="54" as="geometry"/></mxCell><mxCell id="n19" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="232" y="1003" width="24" height="24" as="geometry"/></mxCell><mxCell id="n20" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="232" y="1113" width="24" height="24" as="geometry"/></mxCell><mxCell id="n21" value="A2. Lập phương án chính duy nhất, ghi lý do và cảnh báo rủi ro" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="419" y="1098" width="215" height="54" as="geometry"/></mxCell><mxCell id="n22" value="8. Lập phương án thay thế hoặc biện pháp giảm thiểu rủi ro" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="123" y="1198" width="242" height="54" as="geometry"/></mxCell><mxCell id="n23" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="232" y="1303" width="24" height="24" as="geometry"/></mxCell><mxCell id="n24" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="232" y="1393" width="24" height="24" as="geometry"/></mxCell><mxCell i