<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-08.1" name="AD UC-08.1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1216" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;PM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="336" height="34" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="336" height="1360" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Tài chính&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="356" y="20" width="420" height="34" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="356" y="54" width="420" height="1360" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="776" y="20" width="420" height="34" as="geometry"/></mxCell><mxCell id="n7" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="776" y="54" width="420" height="1360" as="geometry"/></mxCell><mxCell id="n8" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="72" width="26" height="26" as="geometry"/></mxCell><mxCell id="n9" value="1. Chọn phương án bố trí cần đánh giá chi phí, ghi lý do" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="100" y="133" width="175" height="54" as="geometry"/></mxCell><mxCell id="n10" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="869" y="248" width="24" height="24" as="geometry"/></mxCell><mxCell id="n11" value="E2. Không bắt đầu đánh giá" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1060" y="233" width="126" height="54" as="geometry"/></mxCell><mxCell id="n12" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="333" width="24" height="24" as="geometry"/></mxCell><mxCell id="n13" value="2. Hiển thị phương án, phạm vi công việc, nhân sự, số lượng, thời gian, mức độ tham gia" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="786" y="342" width="189" height="56" as="geometry"/></mxCell><mxCell id="n14" value="3. Lượng hóa, xác nhận yếu tố tạo chi phí: nhân sự, số lượng, thời gian, mức độ tham gia" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="83" y="442" width="210" height="56" as="geometry"/></mxCell><mxCell id="n15" value="4. Cung cấp, cập nhật đơn giá; ghi nhận chi phí thực tế nếu đã phát sinh" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="370" y="542" width="182" height="56" as="geometry"/></mxCell><mxCell id="n16" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="449" y="668" width="24" height="24" as="geometry"/></mxCell><mxCell id="n17" value="E1. Đánh dấu dữ liệu thiếu, yêu cầu Tài chính bổ sung; chưa kết luận chính thức" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="965" y="652" width="182" height="56" as="geometry"/></mxCell><mxCell id="n18" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1044" y="753" width="24" height="24" as="geometry"/></mxCell><mxCell id="n19" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="449" y="788" width="24" height="24" as="geometry"/></mxCell><mxCell id="n20" value="A1. Tính lại phần chi phí bị ảnh hưởng, cập nhật dự báo" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632" y="772" width="140" height="56" as="geometry"/></mxCell><mxCell id="n21" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="449" y="898" width="24" height="24" as="geometry"/></mxCell><mxCell id="n22" value="5. Tính chi phí dự toán; cập nhật dự báo, lưu tách dự toán và dự báo" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="370" y="972" width="182" height="56" as="geometry"/></mxCell><mxCell id="n23" value="6. Xem kết quả chi phí dự toán, dự báo của phương án" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="100" y="1083" width="175" height="54" as="geometry"/></mxCell><mxCell id="n24" value="7. Lưu kết quả chi phí, sẵn sàng cho UC-08.2 Đối chiếu chi phí và ngân sách" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="7