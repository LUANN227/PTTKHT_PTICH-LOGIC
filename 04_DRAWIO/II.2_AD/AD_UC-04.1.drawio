<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-04.1" name="AD UC-04.1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;RM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="537" height="34" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="537" height="1520" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="557" y="20" width="503" height="34" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="557" y="54" width="503" height="1520" as="geometry"/></mxCell><mxCell id="n6" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="141" y="72" width="26" height="26" as="geometry"/></mxCell><mxCell id="n7" value="1. Tiếp nhận yêu cầu nguồn lực, khung thời gian và shortlist từ V4" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="41" y="123" width="226" height="54" as="geometry"/></mxCell><mxCell id="n8" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="142" y="238" width="24" height="24" as="geometry"/></mxCell><mxCell id="n9" value="A6. Đánh giá nhanh theo phân bổ cứng, ghi nhận rủi ro, tiếp tục theo dõi" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="318" y="222" width="210" height="56" as="geometry"/></mxCell><mxCell id="n10" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="411" y="318" width="24" height="24" as="geometry"/></mxCell><mxCell id="n11" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="142" y="368" width="24" height="24" as="geometry"/></mxCell><mxCell id="n12" value="2. Kiểm tra đầu vào: yêu cầu, khung thời gian, shortlist" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="595" y="353" width="210" height="54" as="geometry"/></mxCell><mxCell id="n13" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="687" y="468" width="24" height="24" as="geometry"/></mxCell><mxCell id="n14" value="A1. Yêu cầu bổ sung, xác nhận thông tin; chưa kết luận" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="318" y="453" width="210" height="54" as="geometry"/></mxCell><mxCell id="n15" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="687" y="558" width="24" height="24" as="geometry"/></mxCell><mxCell id="n16" value="3. Tra cứu năng lực chuẩn, lịch, nghỉ, phân bổ cứng và mềm của ứng viên; kiểm tra độ mới" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="586" y="612" width="226" height="56" as="geometry"/></mxCell><mxCell id="n17" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="142" y="728" width="24" height="24" as="geometry"/></mxCell><mxCell id="n18" value="A2. Gắn nhãn “dữ liệu chưa đủ rõ”" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="318" y="713" width="210" height="54" as="geometry"/></mxCell><mxCell id="n19" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="411" y="833" width="24" height="24" as="geometry"/></mxCell><mxCell id="n20" value="A2. Đặt chờ xác nhận trong 2 ngày làm việc" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="838" y="818" width="193" height="54" as="geometry"/></mxCell><mxCell id="n21" value="A2. Coi như chưa có dữ liệu, gửi yêu cầu xác nhận ngay" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="595" y="918" width="210" height="54" as="geometry"/></mxCell><mxCell id="n22" value="4. Xác định năng lực khả dụng thực tế: năng lực chuẩn trừ nghỉ, không tính phí, phân bổ cứng" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="41" y="817" width="226" height="56" as="geometry"/></mxCell><mxCell id="n23" value="5. Đối chiếu mức sử dụng với 70–85%; trên 85% xem phần chờ xác nhận; trên 90% liên tục trên 2 tuần gắn cờ Mức 2" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="37" y="917" width="235" height="56" as="geometry"/></mxCell><mxCell id="n24" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="687" y="1018" width="24" height="24" as="geometry"/></mxCell><mxCell id="n25" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="142" y="1018" width="24" height="24" as="geometry"/></mxCell><mxCell id="n26" value="6. Ghi nhận kết luận theo bốn trạng thái kèm căn cứ (dữ liệu chưa rõ: chờ xác nhận)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="37" y="1077" width="235" height="56" as="geometry"/></mxCell><mxCell id="n27" value="7. Lưu kết luận và căn cứ của ứng viên" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="595" y="1078" width="210" height="54" as="geometry"/></mxCell><mxCell id="n28" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="687" y="1193" width="24" height="24" as="geometry"/></mxCell><mxCell id="n29" value="8. Tổng hợp kết luận của từng ứng viên, bàn giao" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="49" y="1278" width="210" height="54" as="geometry"/></mxCell><mxCell id="n30" value="9. Chuyển theo kết luận: đầy đủ → V6 (cờ Mức 2 kèm sang V6, V10); một phần → UC-04.2 (A4); vượt tải ngoại lệ → UC-04.3 (A5); trùng phân bổ cứng → V7 (A3)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="582" y="1370" width="268" height="70" as="geometry"/></mxCell><mxCell id="n31" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="702" y="1481" width="28" height="28" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;fontFamily=Arial;exitX=