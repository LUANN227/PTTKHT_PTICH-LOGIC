<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-07.1" name="AD UC-07.1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;PMO/Quản lý danh mục&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="422" height="34" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="422" height="1180" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Cấp thẩm quyền (PMO Mức 1–3 / CEO Mức 4–5)&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="442" y="20" width="323" height="34" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="442" y="54" width="323" height="1180" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="765" y="20" width="295" height="34" as="geometry"/></mxCell><mxCell id="n7" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="765" y="54" width="295" height="1180" as="geometry"/></mxCell><mxCell id="n8" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="105" y="72" width="26" height="26" as="geometry"/></mxCell><mxCell id="n9" value="1. Tiếp nhận hồ sơ phương án gửi trình duyệt từ V6 hoặc V7" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="31" y="133" width="176" height="54" as="geometry"/></mxCell><mxCell id="n10" value="2. Đối chiếu mức rủi ro với ma trận DoA, xác định cấp thẩm quyền" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="814" y="233" width="197" height="54" as="geometry"/></mxCell><mxCell id="n11" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="106" y="348" width="24" height="24" as="geometry"/></mxCell><mxCell id="n12" value="A1. Chuyển cấp hồ sơ lên CEO/Managing Director trong tối đa 1 ngày làm việc" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="259" y="332" width="155" height="56" as="geometry"/></mxCell><mxCell id="n13" value="A1. CEO/Managing Director tiếp nhận hồ sơ chuyển cấp" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="515" y="433" width="176" height="54" as="geometry"/></mxCell><mxCell id="n14" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="591" y="538" width="24" height="24" as="geometry"/></mxCell><mxCell id="n15" value="3. Rà soát tính hợp lý: phân bổ nhân sự, mức đáp ứng năng lực, tỷ lệ tải trọng, điểm xung đột" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="491" y="612" width="225" height="56" as="geometry"/></mxCell><mxCell id="n16" value="4. Cung cấp thông tin chi phí, chênh lệch ngân sách (V9) và cung – cầu, kết quả dự báo (V10)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" ver