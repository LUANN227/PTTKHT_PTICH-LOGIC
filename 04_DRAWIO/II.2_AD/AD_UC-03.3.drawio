ex="1" parent="1"><mxGeometry x="94" y="123" width="194" height="54" as="geometry"/></mxCell><mxCell id="n10" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="512" y="138" width="24" height="24" as="geometry"/></mxCell><mxCell id="n11" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="749" y="138" width="24" height="24" as="geometry"/></mxCell><mxCell id="n12" value="2. Trình bày nhu cầu, ứng viên, điều kiện bắt buộc, tiêu chí, trọng số, năng lực từ hồ sơ tập trung" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="412" y="237" width="225" height="56" as="geometry"/></mxCell><mxCell id="n13" value="3. Đối chiếu điều kiện bắt buộc; loại ứng viên xung đột lợi ích (A1)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="86" y="338" width="210" height="54" as="geometry"/></mxCell><mxCell id="n14" value="4. Ghi phân loại và lý do không đạt; cảnh báo kỹ năng chưa xác nhận hoặc quá hạn (A3)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="412" y="437" width="225" height="56" as="geometry"/></mxCell><mxCell id="n15" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="179" y="563" width="24" height="24" as="geometry"/></mxCell><mxCell id="n16" value="A2. Ghi đề nghị miễn trừ kèm lý do" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="94" y="663" width="194" height="54" as="geometry"/></mxCell><mxCell id="n17" value="A2. Phê duyệt hoặc từ chối đề nghị miễn trừ" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="850" y="663" width="186" height="54" as="geometry"/></mxCell><mxCell id="n18" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="512" y="778" width="24" height="24" as="geometry"/></mxCell><mxCell id="n19" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="512" y="868" width="24" height="24" as="geometry"/></mxCell><mxCell id="n20" value="E3. Lưu phân loại, lý do loại; không lập shortlist (RM tìm tiếp ở UC-03.2)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="641" y="852" width="179" height="56" as="geometry"/></mxCell><mxCell id="n21" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="718" y="958" width="24" height="24" as="geometry"/></mxCell><mxCell id="n22" value="6. Chấm điểm từng tiêu chí cho ứng viên đủ điều kiện" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="94" y="973" width="194" height="54" as="geometry"/></mxCell><mxCell id="n23" value="7. Tính điểm tổng theo trọng số; xếp hạng; đồng hạng theo thứ tự ưu tiên nguồn (A4)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="412" y="1072" width="225" height="56" as="geometry"/></mxCell><mxCell id="n24" value="8. Lập shortlist: tối thiểu 1 ứng viên chính, khuyến nghị 1–2 thay thế (A5)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" paren