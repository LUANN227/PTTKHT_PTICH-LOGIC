<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-06.2" name="AD UC-06.2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1090" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;RM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="490" height="34" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="490" height="1340" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;PM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="510" y="20" width="266" height="34" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="510" y="54" width="266" height="1340" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="776" y="20" width="294" height="34" as="geometry"/></mxCell><mxCell id="n7" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="776" y="54" width="294" height="1340" as="geometry"/></mxCell><mxCell id="n8" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="133" y="72" width="26" height="26" as="geometry"/></mxCell><mxCell id="n9" value="1. Chọn điểm xung đột cần cân đối (từ UC-06.1); mở phiên đàm phán" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="122" width="189" height="56" as="geometry"/></mxCell><mxCell id="n10" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="134" y="238" width="24" height="24" as="geometry"/></mxCell><mxCell id="n11" value="E1. Chỉ ghi nhận để theo dõi" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="304" y="223" width="161" height="54" as="geometry"/></mxCell><mxCell id="n12" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="372" y="318" width="24" height="24" as="geometry"/></mxCell><mxCell id="n13" value="2. Hiển thị điểm xung đột, kịch bản, đường găng, khoảng dự trữ, xếp hạng danh mục; theo dõi hạn 3 ngày làm việc" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="818" y="335" width="210" height="70" as="geometry"/></mxCell><mxCell id="n14" value="3. Đàm phán chia sẻ, thay thế hoặc điều chỉnh nhu cầu nguồn lực" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="443" width="189" height="54" as="geometry"/></mxCell><mxCell id="n15" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="134" y="558" width="24" height="24" as="geometry"/></mxCell><mxCell id="n16" value="A1. Quá 3 ngày làm việc hoặc bế tắc: chuyển hồ sơ sang UC-06.3" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="328" y="542" width="147" height="56" as="geometry"/></mxCell><mxCell id="n17" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="638" width="24" height="24" as="geometry"/></mxCell><mxCell id="n18" value="4. Ghi nhận phương án được thống nhất" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="58" y="653" width="175" height="54" as="geometry"/></mxCell><mxCell id="n19" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="134" y="768" width="24" height="24" as="geometry"/></mxCell><mxCell id="n20" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="372" y="768" width="24" height="24" as="geometry"/></mxCell><mxCell id="n21" value="A3. RM và PM lập đề xuất lùi mốc tiến độ gốc hoặc cắt giảm phạm vi" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="548" y="752" width="189" height="56" as="geometry"/></mxCell><mxCell id="n22" value="5. Làm mịn: điều chỉnh thời điểm trong khoảng dự trữ, không đổi ngày hoàn thành" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="862" width="189" height="56" as="geometry"/></mxCell><mxCell id="n23" value="A2. San bằng nguồn lực trong hạn mức công suất" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="304" y="863" width="161" height="54" as="geometry"/></mxCell><mxCell id="n24" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="372" y="978" width="24" height="24" as="geometry"/></mxCell><mxCell id="n25" value="6. Ghi điều chỉnh trên phương án; kiểm tra tổng phân bổ mỗi người không quá 100%" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="818" y="1042" width="210" height="56" as="geometry"/></mxCell><mxCell id="n26" value="7. Ghi nhật ký xử lý xung đột: điểm xung đột, đàm phán, điều chỉnh" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="1142" width="189" height="56" as="geometry"/></mxCell><mxCell id="n27" value="8. Hoàn thiện phương án đã cân đối, bàn giao V8, V9, V10 (kèm đề xuất thay đổi nếu có)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="48" y="1237" width="196" height="56" as="geometry"/></mxCell><mxCell id="n28" value="9. Lưu nhật ký (tối thiểu 3 năm); chuyển phương án sang V8, V9, V10" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="818" y="1238" width="210" height="54" as="geometry"/></mxCell><mxCell id="n29" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="909" y="1336" width="28" height="28" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;fontFamily=Arial;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;fontFamily=Arial;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeSty