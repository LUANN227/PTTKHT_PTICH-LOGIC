@startuml II3_View_B_V5-V7
' Sinh tự động từ II3_Lop_Mien_Tong_Quat.puml bằng _cong_cu/tach_view_II3.py. Không sửa tay.
!pragma layout smetana
' II.3 - So do lop mien tong quat (tich hop V2-V10)
' Chi ghi thuoc tinh chinh, an thao tac. Danh muc day du: II3_Danh_muc_va_anh_xa.md
' <<de xuat>>: lop chi co can cu tu mot bai thanh vien, cho truong nhom xac nhan.
hide circle
hide methods
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam stereotypeCBackgroundColor #FFFFFF

title Khung nhìn B: Khả năng tham gia, phương án, xung đột (V5–V7)
package "Khả năng tham gia và lịch (V5)" {
  class LichNguonLuc {
    thoiGianNghi
    ngayCapNhat
  }
  class PhanBoNguonLuc {
    loaiPhanBo
    tuNgay
    denNgay
    tyLe
    trangThaiXacNhan
  }
  class KetLuanKhaNangThamGia {
    trangThaiKhaNang
    mucSuDung
    thoiGianTrong
    coRuiRoQuaTai
  }
  class DeXuatThamGiaMotPhan {
    tyLe
    khungThoiGian
    trangThaiPM
  }
  class HoSoVuotTaiNgoaiLe {
    mucCanhBao
    lyDo
    capThamQuyen
    trangThai
  }
}
package "Phương án (V6)" {
  class PhuongAnBoTri {
    maPhuongAn
    phienBan
    loaiPhuongAn
    trangThai
    laChapNhanMotPhan
  }
  class ChiTietBoTri {
    vaiTroDuocGan
    tyLeThamGia
    tuNgay
    denNgay
  }
  class RuiRoViTri {
    loaiRuiRo
    bienPhapGiamThieu
  }
}
package "Xung đột (V7)" {
  class DiemXungDot {
    maXungDot
    mucSuDung
    mucCanhBao
  }
  class NhatKyXuLyXungDot {
    thoiDiem
    noiDung
    loaiXuLy
  }
  class PhanXuXungDot {
    ngayChuyenCap
    lyDoBeTac
    capPhanXu
    noiDungQuyetDinh
  }
  class DeXuatThayDoi <<đề xuất>> {
    loaiThayDoi
    noiDung
  }
}
package "Lớp của vùng khác (chỉ tham chiếu)" #F5F5F5 {
  class ChiPhiThucTe #EEEEEE
  class ChiTietSoSanh #EEEEEE
  class DanhGiaChiPhi #EEEEEE
  class DonGia #EEEEEE
  class DuAn #EEEEEE
  class DuToanChiPhi #EEEEEE
  class HoSoTrinhDuyet #EEEEEE
  class KetQuaDanhGiaPhuHop #EEEEEE
  class NguonLuc #EEEEEE
  class NhuCauNguonLuc #EEEEEE
  class ViTriCanBoTri #EEEEEE
}
hide ChiPhiThucTe members
hide ChiTietSoSanh members
hide DanhGiaChiPhi members
hide DonGia members
hide DuAn members
hide DuToanChiPhi members
hide HoSoTrinhDuyet members
hide KetQuaDanhGiaPhuHop members
hide NguonLuc members
hide NhuCauNguonLuc members
hide ViTriCanBoTri members
NguonLuc "1" -- "1" LichNguonLuc
LichNguonLuc "1" *-- "0..*" PhanBoNguonLuc
PhanBoNguonLuc "0..*" -- "1" DuAn
KetQuaDanhGiaPhuHop "1" -- "0..1" KetLuanKhaNangThamGia : shortlist
