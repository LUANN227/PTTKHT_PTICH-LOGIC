<mxfile host="puml_to_drawio.py" type="device"><diagram id="II3_View_C_V8-V10" name="II3_View_C_V8-V10"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml II3_View_C_V8-V10\n&#x27; Sinh tự động từ II3_Lop_Mien_Tong_Quat.puml bằng _cong_cu/tach_view_II3.py. Không sửa tay.\n!pragma layout smetana\n&#x27; II.3 - So do lop mien tong quat (tich hop V2-V10)\n&#x27; Chi ghi thuoc tinh chinh, an thao tac. Danh muc day du: II3_Danh_muc_va_anh_xa.md\n&#x27; &lt;&lt;de xuat&gt;&gt;: lop chi co can cu tu mot bai thanh vien, cho truong nhom xac nhan.\nhide circle\nhide methods\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam packageStyle rectangle\nskinparam class {\n  BackgroundColor #FFFFFF\n  BorderColor #333333\n}\nskinparam stereotypeCBackgroundColor #FFFFFF\n\ntitle Khung nhìn C: Phê duyệt, chi phí, dự báo (V8–V10)\npackage \&quot;Phê duyệt (V8)\&quot; {\n  class HoSoTrinhDuyet {\n    maHoSo\n    ngayTrinh\n    mucRuiRo\n    capThamQuyen\n    trangThaiXuLy\n  }\n  class YeuCauGiaiTrinh {\n    noiDungCanLamRo\n    ngayYeuCau\n    trangThai\n  }\n  class QuyetDinhPheDuyet {\n    loaiQuyetDinh\n    lyDo\n    dieuKienApDung\n    nguoiQuyetDinh\n    thoiDiem\n  }\n}\npackage \&quot;Chi phí và ngân sách (V9)\&quot; {\n  class DonGia {\n    loaiNguonLuc\n    giaTri\n    ngayApDung\n  }\n  class DuToanChiPhi {\n    ngayLap\n    /tongChiPhi\n  }\n  class DuBaoChiPhi {\n    ngayCapNhat\n    lyDoCapNhat\n  }\n  class ChiPhiThucTe {\n    soTien\n    ngayPhatSinh\n  }\n  class NganSach {\n    nganSachDuyet\n    /conLai\n  }\n  class DanhGiaChiPhi {\n    thoiDiem\n    chenhLech\n    tyLeVuot\n    trangThaiNganSach\n  }\n  class NguyenNhanVuot {\n    noiDung\n  }\n  class HuongXuLy {\n    loai\n    ghiChu\n  }\n  class SoSanhPhuongAn {\n    thoiDiem\n  }\n  class ChiTietSoSanh {\n    mucChatLuong\n    thoiGian\n    /chiPhi\n  }\n}\npackage \&quot;Theo dõi và dự báo (V10)\&quot; {\n  class KetQuaDuBao {\n    loaiLap\n    tuNgay\n    denNgay\n    mucThieuDuLieu\n    quyetDinhChuyen\n  }\n  class TongHopNguonCung {\n    khoangThoiGian\n    /nguonCungCoTheDapUng\n  }\n  class NhuCauDuBao {\n    mucDoChacChan\n    duCoSo\n  }\n  class DongDoiChieuCungCau {\n    khoangThoiGian\n    mucDoDapUng\n    chenhLech\n    laThieuNangLuc\n  }\n}\npackage \&quot;Lớp của vùng khác (chỉ tham chiếu)\&quot; #F5F5F5 {\n  class ChiTietBoTri #EEEEEE\n  class DuAn #EEEEEE\n  class NguonLuc #EEEEEE\n  class NhuCauNguonLuc #EEEEEE\n  class PhanHoiNhuCau #EEEEEE\n  class PhuongAnBoTri #EEEEEE\n}\nhide ChiTietBoTri members\nhide DuAn members\nhide NguonLuc members\nhide NhuCauNguonLuc members\nhide PhanHoiNhuCau members\nhide PhuongAnBoTri members\nPhuongAnBoTri \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoTrinhDuyet\nHoSoTrinhDuyet \&quot;1\&quot; *-- \&quot;0..*\&quot; YeuCauGiaiTrinh\nHoSoTrinhDuyet \&quot;1\&quot; -- \&quot;0..1\&quot; QuyetDinhPheDuyet\nHoSoTrinhDuyet \&quot;0..*\&quot; -- \&quot;0..*\&quot; DanhGiaChiPhi : tham chiếu\nHoSoTrinhDuyet \&quot;0..*\&quot; -- \&quot;0..1\&quot; KetQuaDuBao : tham chiếu\nChiTietBoTri \&quot;0..*\&quot; -- \&quot;1\&quot; DonGia\nPhuongAnBoTri \&quot;1\&quot; -- \&quot;0..1\&quot; DuToanChiPhi\nDuToanChiPhi \&quot;1\&quot; -- \&quot;0..*\&quot; DuBaoChiPhi\nPhuongAnBoTri \&quot;1\&quot; -- \&quot;0..*\&quot; ChiPhiThucTe\nPhuongAnBoTri \&quot;1\&quot; -- \&quot;0..*\&quot; DanhGiaChiPhi\nDanhGiaChiPhi \&quot;0..*\&quot; -- \&quot;1\&quot; NganSach\nNganSach \&quot;1\&quot; -- \&quot;0..*\&quot; ChiPhiThucTe\nDuAn \&quot;1\&quot; -- \&quot;0..*\&quot; NganSach\nDanhGiaChiPhi \&quot;1\&quot; *-- \&quot;0..*\&quot; NguyenNhanVuot\nDanhGiaChiPhi \&quot;1\&quot; *-- \&quot;0..1\&quot; HuongXuLy\nDanhGiaChiPhi \&quot;1\&quot; -- \&quot;0..1\&quot; SoSanhPhuongAn\nSoSanhPhuongAn \&quot;1\&quot; *-- \&quot;2..*\&quot; ChiTietSoSanh\nChiTietSoSanh \&quot;0..*\&quot; -- \&quot;1\&quot; PhuongAnBoTri\nKetQuaDuBao \&quot;1\&quot; *-- \&quot;0..*\&quot; TongHopNguonCung\nKetQuaDuBao \&quot;1\&quot; *-- \&quot;0..*\&quot; NhuCauDuBao\nKetQuaDuBao \&quot;1\&quot; *-- \&quot;0..*\&quot; DongDoiChieuCungCau\nTongHopNguonCung \&quot;0..*\&quot; -- \&quot;1\&quot; NguonLuc\nNhuCauDuBao \&quot;0..*\&quot; -- \&quot;0..1\&quot; NhuCauNguonLuc\nPhanHoiNhuCau \&quot;0..*\&quot; -- \&quot;0..1\&quot; KetQuaDuBao\n@enduml\n&quot;, &quot;format&quot;: &quot;svg&quot;}" id="p1"><mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="800" height="600" as="geometry"/></mxCell></UserObject></root></mxGraphModel></diagram></mxfile>
