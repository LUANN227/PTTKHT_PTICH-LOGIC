<mxfile host="puml_to_drawio.py" type="device"><diagram id="II3_Tong_Quan_Ten_Lop" name="II3_Tong_Quan_Ten_Lop"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml II3_Tong_Quan_Ten_Lop\n&#x27; Sinh tự động từ II3_Lop_Mien_Tong_Quat.puml. Không sửa tay.\n!pragma layout smetana\n&#x27; II.3 - So do lop mien tong quat (tich hop V2-V10)\n&#x27; Chi ghi thuoc tinh chinh, an thao tac. Danh muc day du: II3_Danh_muc_va_anh_xa.md\n&#x27; &lt;&lt;de xuat&gt;&gt;: lop chi co can cu tu mot bai thanh vien, cho truong nhom xac nhan.\nhide circle\nhide members\ntitle Tổng quan lớp miền (chỉ tên lớp và liên kết)\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam packageStyle rectangle\nskinparam class {\n  BackgroundColor #FFFFFF\n  BorderColor #333333\n}\nskinparam stereotypeCBackgroundColor #FFFFFF\n\npackage \&quot;Dự án và nhu cầu (V2)\&quot; {\n  class DuAn {\n    maDuAn\n    tenDuAn\n    ngayBatDau\n    ngayKetThuc\n    hangUuTien\n  }\n  class GiaiDoanDuAn {\n    maGiaiDoan\n    tenGiaiDoan\n    ngayBatDau\n    ngayKetThuc\n  }\n  class NhuCauNguonLuc {\n    maNhuCau\n    phamViCongViec\n    thoiGianBatDau\n    thoiGianKetThuc\n    trangThai\n  }\n  class ViTriCanBoTri {\n    maViTri\n    vaiTro\n    soLuong\n    tyLeFTE\n  }\n  class YeuCauKyNang {\n    capDoYeuCau\n    batBuoc\n  }\n  class PhanHoiNhuCau {\n    maPhanHoi\n    nguonPhanHoi\n    noiDung\n    thoiDiem\n  }\n  class YeuCauNguonLuc &lt;&lt;đề xuất&gt;&gt; {\n    maYeuCau\n    khungThoiGian\n  }\n}\n\npackage \&quot;Năng lực (V3)\&quot; {\n  class NguonLuc {\n    maNguonLuc\n    hoTen\n    loaiNguon\n    nangLucChuan\n  }\n  class KyNang {\n    maKyNang\n    tenKyNang\n  }\n  class HoSoNangLuc {\n    kinhNghiem\n    chungChi\n    mucDapUngVaiTro\n    khoangThieu\n  }\n  class NangLucKyNang {\n    mucThanhThao\n    trangThaiXacNhan\n    ngayDanhGia\n  }\n  class BoTieuChiNangLuc {\n    maBo\n    trangThai\n  }\n  class TieuChiNangLuc {\n    maTieuChi\n    tenTieuChi\n    trangThai\n  }\n  class MucDoNangLuc {\n    thuTu\n    moTa\n    dieuKienCongNhan\n  }\n}\n\npackage \&quot;Tìm kiếm và phù hợp (V4)\&quot; {\n  class BoTieuChiPhuHop {\n    phienBan\n    ngayXacLap\n  }\n  class TieuChiPhuHop {\n    tenTieuChi\n    loai\n    trongSo\n  }\n  class PhienTimKiem {\n    maPhien\n    thoiDiem\n    trangThai\n  }\n  class KetQuaDanhGiaPhuHop {\n    phanLoai\n    diemTong\n    thuHang\n    vaiTroShortlist\n  }\n  class DiemTieuChi {\n    diem\n  }\n  class DeNghiMienTru {\n    lyDo\n    trangThai\n  }\n}\n\npackage \&quot;Khả năng tham gia và lịch (V5)\&quot; {\n  class LichNguonLuc {\n    thoiGianNghi\n    ngayCapNhat\n  }\n  class PhanBoNguonLuc {\n    loaiPhanBo\n    tuNgay\n    denNgay\n    tyLe\n    trangThaiXacNhan\n  }\n  class KetLuanKhaNangThamGia {\n    trangThaiKhaNang\n    mucSuDung\n    thoiGianTrong\n    coRuiRoQuaTai\n  }\n  class DeXuatThamGiaMotPhan {\n    tyLe\n    khungThoiGian\n    trangThaiPM\n  }\n  class HoSoVuotTaiNgoaiLe {\n    mucCanhBao\n    lyDo\n    capThamQuyen\n    trangThai\n  }\n}\n\npackage \&quot;Phương án (V6)\&quot; {\n  class PhuongAnBoTri {\n    maPhuongAn\n    phienBan\n    loaiPhuongAn\n    trangThai\n    laChapNhanMotPhan\n  }\n  class ChiTietBoTri {\n    vaiTroDuocGan\n    tyLeThamGia\n    tuNgay\n    denNgay\n  }\n  class RuiRoViTri {\n    loaiRuiRo\n    bienPhapGiamThieu\n  }\n}\n\npackage \&quot;Xung đột (V7)\&quot; {\n  class DiemXungDot {\n    maXungDot\n    mucSuDung\n    mucCanhBao\n  }\n  class NhatKyXuLyXungDot {\n    thoiDiem\n    noiDung\n    loaiXuLy\n  }\n  class PhanXuXungDot {\n    ngayChuyenCap\n    lyDoBeTac\n    capPhanXu\n    noiDungQuyetDinh\n  }\n  class DeXuatThayDoi &lt;&lt;đề xuất&gt;&gt; {\n    loaiThayDoi\n    noiDung\n  }\n}\n\npackage \&quot;Phê duyệt (V8)\&quot; {\n  class HoSoTrinhDuyet {\n    maHoSo\n    ngayTrinh\n    mucRuiRo\n    capThamQuyen\n    trangThaiXuLy\n  }\n  class YeuCauGiaiTrinh {\n    noiDungCanLamRo\n    ngayYeuCau\n    trangThai\n  }\n  class QuyetDinhPheDuyet {\n    loaiQuyetDinh\n    lyDo\n    dieuKienApDung\n    nguoiQuyetDinh\n    thoiDiem\n  }\n}\n\npackage \&quot;Chi phí và ngân sách (V9)\&quot; {\n  class DonGia {\n    loaiNguonLuc\n    giaTri\n    ngayApDung\n  }\n  class DuToanChiPhi {\n    ngayLap\n    /tongChiPhi\n  }\n  class DuBaoChiPhi {\n    ngayCapNhat\n    lyDoCapNhat\n  }\n  class ChiPhiThucTe {\n    soTien\n    ngayPhatSinh\n  }\n  class NganSach {\n    nganSachDuyet\n    /conLai\n  }\n  class DanhGiaChiPhi {\n    thoiDiem\n    chenhLech\n    tyLeVuot\n    trangThaiNganSach\n  }\n  class NguyenNhanVuot {\n    noiDung\n  }\n  class HuongXuLy {\n    loai\n    ghiChu\n  }\n  class SoSanhPhuongAn {\n    thoiDiem\n  }\n  class ChiTietSoSanh {\n    mucChatLuong\n    thoiGian\n    /chiPhi\n  }\n}\n\npackage \&quot;Theo dõi và dự báo (V10)\&quot; {\n  class KetQuaDuBao {\n    loaiLap\n    tuNgay\n    denNgay\n    mucThieuDuLieu\n    quyetDinhChuyen\n  }\n  class TongHopNguonCung {\n    khoangThoiGian\n    /nguonCungCoTheDapUng\n  }\n  class NhuCauDuBao {\n    mucDoChacChan\n    duCoSo\n  }\n  class DongDoiChieuCungCau {\n    khoangThoiGian\n    mucDoDapUng\n    chenhLech\n    laThieuNangLuc\n  }\n}\n\n&#x27; ---- V2\nDuAn \&quot;1\&quot; *-- \&quot;1..*\&quot; GiaiDoanDuAn\nDuAn \&quot;1\&quot; -- \&quot;0..*\&quot; NhuCauNguonLuc\nNhuCauNguonLuc \&quot;1\&quot; *-- \&quot;1..*\&quot; ViTriCanBoTri\nViTriCanBoTri \&quot;0..*\&quot; -- \&quot;0..1\&quot; GiaiDoanDuAn\nViTriCanBoTri \&quot;1\&quot; *-- \&quot;0..*\&quot; YeuCauKyNang\nYeuCauKyNang \&quot;0..*\&quot; -- \&quot;1\&quot; KyNang\nNhuCauNguonLuc \&quot;1\&quot; -- \&quot;0..*\&quot; PhanHoiNhuCau\nDuAn \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauNguonLuc\n&#x27; ---- V3\nNguonLuc \&quot;1\&quot; -- \&quot;1\&quot; HoSoNangLuc\nHoSoNangLuc \&quot;1\&quot; *-- \&quot;0..*\&quot; NangLucKyNang\nNangLucKyNang \&quot;0.