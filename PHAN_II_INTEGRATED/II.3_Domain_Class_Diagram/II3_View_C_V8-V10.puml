@startuml II3_View_C_V8-V10
' Sinh tự động từ II3_Lop_Mien_Tong_Quat.puml bằng _cong_cu/tach_view_II3.py. Không sửa tay.
!pragma layout smetana
' II.3 - So do lop mien tong quat (tich hop V2-V10)
' Chi ghi thuoc tinh chinh, an thao tac. Danh muc day du: II3_Danh_muc_va_anh_xa.md
' <<de xuat>>: lop chi co can cu tu mot bai thanh vien, cho truong nhom xac nhan.
hide circle
hide methods
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam stereotypeCBackgroundColor #FFFFFF

title Khung nhìn C: Phê duyệt, chi phí, dự báo (V8–V10)
package "Phê duyệt (V8)" {
  class HoSoTrinhDuyet {
    maHoSo
    ngayTrinh
    mucRuiRo
    capThamQuyen
    trangThaiXuLy
  }
  class YeuCauGiaiTrinh {
    noiDungCanLamRo
    ngayYeuCau
    trangThai
  }
  class QuyetDinhPheDuyet {
    loaiQuyetDinh
    lyDo
    dieuKienApDung
    nguoiQuyetDinh
    thoiDiem
  }
}
package "Chi phí và ngân sách (V9)" {
  class DonGia {
    loaiNguonLuc
    giaTri
    ngayApDung
  }
  class DuToanChiPhi {
    ngayLap
    /tongChiPhi
  }
  class DuBaoChiPhi {
    ngayCapNhat
    lyDoCapNhat
  }
  class ChiPhiThucTe {
    soTien
    ngayPhatSinh
  }
  class NganSach {
    nganSachDuyet
    /conLai
  }
  class DanhGiaChiPhi {
    thoiDiem
    chenhLech
    tyLeVuot
    trangThaiNganSach
  }
  class NguyenNhanVuot {
    noiDung
  }
  class HuongXuLy {
    loai
    ghiChu
  }
  class SoSanhPhuongAn {
    thoiDiem
  }
  class ChiTietSoSanh {
    mucChatLuong
    thoiGian
    /chiPhi
  }
}
package "Theo dõi và dự báo (V10)" {
  class KetQuaDuBao {
    loaiLap
    tuNgay
    denNgay
    mucThieuDuLieu
    quyetDinhChuyen
  }
  class TongHopNguonCung {
    khoangThoiGian
    /nguonCungCoTheDapUng
  }
  class NhuCauDuBao {
    mucDoChacChan
    duCoSo
  }
  class DongDoiChieuCungCau {
    khoangThoiGian
    mucDoDapUng
    chenhLech
    laThieuNangLuc
  }
}
package "Lớp của vùng khác (chỉ tham chiếu)" #F5F5F5 {
  class ChiTietBoTri #EEEEEE
  class DuAn #EEEEEE
  class NguonLuc #EEEEEE
  class NhuCauNguonLuc #EEEEEE
  class PhanHoiNhuCau #EEEEEE
  class PhuongAnBoTri #EEEEEE
}
hide ChiTietBoTri members
hide DuAn members
hide NguonLuc members
hide NhuCauNguonLuc members
hide PhanHoiNhuCau members
hide PhuongAnBoTri members
PhuongAnBoTri "1" -- "0..*" HoSoTrinhDuyet
HoSoTrinhDuyet "1" *-- "0..*" YeuCauGiaiTrinh
HoSoTrinhDuyet "1" -- "0..1" QuyetDinhPheDuyet
HoSoTrinhDuyet "0..*" -- "0..*" DanhGiaChiPhi : tham chiếu
HoSoTrinhDuyet "0..*" -- "0..1" KetQuaDuBao : tham chiếu
