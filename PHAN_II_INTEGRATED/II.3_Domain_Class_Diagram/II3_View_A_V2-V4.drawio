<mxfile host="puml_to_drawio.py" type="device"><diagram id="II3_View_A_V2-V4" name="II3_View_A_V2-V4"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml II3_View_A_V2-V4\n&#x27; Sinh tự động từ II3_Lop_Mien_Tong_Quat.puml bằng _cong_cu/tach_view_II3.py. Không sửa tay.\n!pragma layout smetana\n&#x27; II.3 - So do lop mien tong quat (tich hop V2-V10)\n&#x27; Chi ghi thuoc tinh chinh, an thao tac. Danh muc day du: II3_Danh_muc_va_anh_xa.md\n&#x27; &lt;&lt;de xuat&gt;&gt;: lop chi co can cu tu mot bai thanh vien, cho truong nhom xac nhan.\nhide circle\nhide methods\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam packageStyle rectangle\nskinparam class {\n  BackgroundColor #FFFFFF\n  BorderColor #333333\n}\nskinparam stereotypeCBackgroundColor #FFFFFF\n\ntitle Khung nhìn A: Nhu cầu, năng lực, tìm kiếm (V2–V4)\npackage \&quot;Dự án và nhu cầu (V2)\&quot; {\n  class DuAn {\n    maDuAn\n    tenDuAn\n    ngayBatDau\n    ngayKetThuc\n    hangUuTien\n  }\n  class GiaiDoanDuAn {\n    maGiaiDoan\n    tenGiaiDoan\n    ngayBatDau\n    ngayKetThuc\n  }\n  class NhuCauNguonLuc {\n    maNhuCau\n    phamViCongViec\n    thoiGianBatDau\n    thoiGianKetThuc\n    trangThai\n  }\n  class ViTriCanBoTri {\n    maViTri\n    vaiTro\n    soLuong\n    tyLeFTE\n  }\n  class YeuCauKyNang {\n    capDoYeuCau\n    batBuoc\n  }\n  class PhanHoiNhuCau {\n    maPhanHoi\n    nguonPhanHoi\n    noiDung\n    thoiDiem\n  }\n  class YeuCauNguonLuc &lt;&lt;đề xuất&gt;&gt; {\n    maYeuCau\n    khungThoiGian\n  }\n}\npackage \&quot;Năng lực (V3)\&quot; {\n  class NguonLuc {\n    maNguonLuc\n    hoTen\n    loaiNguon\n    nangLucChuan\n  }\n  class KyNang {\n    maKyNang\n    tenKyNang\n  }\n  class HoSoNangLuc {\n    kinhNghiem\n    chungChi\n    mucDapUngVaiTro\n    khoangThieu\n  }\n  class NangLucKyNang {\n    mucThanhThao\n    trangThaiXacNhan\n    ngayDanhGia\n  }\n  class BoTieuChiNangLuc {\n    maBo\n    trangThai\n  }\n  class TieuChiNangLuc {\n    maTieuChi\n    tenTieuChi\n    trangThai\n  }\n  class MucDoNangLuc {\n    thuTu\n    moTa\n    dieuKienCongNhan\n  }\n}\npackage \&quot;Tìm kiếm và phù hợp (V4)\&quot; {\n  class BoTieuChiPhuHop {\n    phienBan\n    ngayXacLap\n  }\n  class TieuChiPhuHop {\n    tenTieuChi\n    loai\n    trongSo\n  }\n  class PhienTimKiem {\n    maPhien\n    thoiDiem\n    trangThai\n  }\n  class KetQuaDanhGiaPhuHop {\n    phanLoai\n    diemTong\n    thuHang\n    vaiTroShortlist\n  }\n  class DiemTieuChi {\n    diem\n  }\n  class DeNghiMienTru {\n    lyDo\n    trangThai\n  }\n}\npackage \&quot;Lớp của vùng khác (chỉ tham chiếu)\&quot; #F5F5F5 {\n  class ChiTietBoTri #EEEEEE\n  class DiemXungDot #EEEEEE\n  class KetLuanKhaNangThamGia #EEEEEE\n  class KetQuaDuBao #EEEEEE\n  class LichNguonLuc #EEEEEE\n  class NganSach #EEEEEE\n  class NhuCauDuBao #EEEEEE\n  class PhanBoNguonLuc #EEEEEE\n  class PhuongAnBoTri #EEEEEE\n  class RuiRoViTri #EEEEEE\n  class TongHopNguonCung #EEEEEE\n}\nhide ChiTietBoTri members\nhide DiemXungDot members\nhide KetLuanKhaNangThamGia members\nhide KetQuaDuBao members\nhide LichNguonLuc members\nhide NganSach members\nhide NhuCauDuBao members\nhide PhanBoNguonLuc members\nhide PhuongAnBoTri members\nhide RuiRoViTri members\nhide TongHopNguonCung members\nDuAn \&quot;1\&quot; *-- \&quot;1..*\&quot; GiaiDoanDuAn\nDuAn \&quot;1\&quot; -- \&quot;0..*\&quot; NhuCauNguonLuc\nNhuCauNguonLuc \&quot;1\&quot; *-- \&quot;1..*\&quot; ViTriCanBoTri\nViTriCanBoTri \&quot;0..*\&quot; -- \&quot;0..1\&quot; GiaiDoanDuAn\nViTriCanBoTri \&quot;1\&quot; *-- \&quot;0..*\&quot; YeuCauKyNang\nYeuCauKyNang \&quot;0..*\&quot; -- \&quot;1\&quot; KyNang\nNhuCauNguonLuc \&quot;1\&quot; -- \&quot;0..*\&quot; PhanHoiNhuCau\nDuAn \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauNguonLuc\nNguonLuc \&quot;1\&quot; -- \&quot;1\&quot; HoSoNangLuc\nHoSoNangLuc \&quot;1\&quot; *-- \&quot;0.