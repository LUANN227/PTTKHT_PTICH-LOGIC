@startuml Class_V10
!pragma layout smetana
' Mo hinh lop mien V10 (UC-09.1, UC-09.2). Lop nen xam: thuoc vung khac, V10 chi tham chieu.
' Nguon: Phan I I.1.3.10, I.2.1.9 (CN-113..126), QT-52..57, RB-53..58, RB-62
hide circle
hide methods
skinparam shadowing false
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

class KetQuaDuBao {
  maDuBao
  loaiLap : định kỳ tuần | ngoài chu kỳ
  thoiDiemLap
  tuNgay
  denNgay
  lyDoDuBaoLai
  mucThieuDuLieu
  ketLuanTongHop
  quyetDinhChuyen : chuyển thông tin | tiếp tục theo dõi
}
class TongHopNguonCung {
  khoangThoiGian
  nangLucHienCo
  phanDaPhanBoCamKet
  /nguonCungCoTheDapUng
  duLieuThieu
}
class NhuCauDuBao {
  vaiTro
  kyNang
  soLuong
  khoangThoiGian
  mucDoChacChan : đã xác nhận | dự kiến
  duCoSo : boolean
  lyDoChuaDuCoSo
}
class DongDoiChieuCungCau {
  khoangThoiGian
  vaiTro
  kyNang
  cungDuBao
  cauDuBao
  mucDoDapUng : đủ | thiếu | dư
  chenhLech
  laThieuNangLuc : boolean
}

class NguonLuc #EEEEEE
class HoSoNangLuc #EEEEEE
class PhanBoNguonLuc #EEEEEE
class NhuCauNguonLuc #EEEEEE
class PhuongAnBoTri #EEEEEE
class DanhGiaChiPhi #EEEEEE
class PhanHoiNhuCau #EEEEEE

KetQuaDuBao "1" *-- "0..*" TongHopNguonCung : gồm
KetQuaDuBao "1" *-- "0..*" NhuCauDuBao : xét
KetQuaDuBao "1" *-- "0..*" DongDoiChieuCungCau : gồm
TongHopNguonCung "0..*" --> "1" NguonLuc : của
TongHopNguonCung ..> PhanBoNguonLuc : trừ phần đã cam kết
TongHopNguonCung ..> HoSoNangLuc : kỹ năng, vai trò
NhuCauDuBao "0..*" --> "0..1" NhuCauNguonLuc : lấy từ V2
PhanBoNguonLuc "0..*" --> "0..1" PhuongAnBoTri : theo Locked Baseline
KetQuaDuBao ..> DanhGiaChiPhi : căn cứ bổ sung,\nkhông dùng để dự báo
PhanHoiNhuCau "0..*" --> "0..1" KetQuaDuBao : nguồn (V2)
@enduml
