@startuml UCD_UC-09
!pragma layout smetana
' UCD cap vung UC-09 (V10). Nguon: HD-PCCN muc 1; Phan I I.1.3.10, I.2.1.9.
' Phan bo CN theo de xuat D-V10-01 (cho truong nhom xac nhan).
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
actor "RM" as RM
actor "PM" as PM
rectangle "UC-09 Theo dõi và dự báo nguồn lực" {
  usecase "UC-09.1\nTổng hợp và phân tích\ncung – cầu nguồn lực" as U1
  usecase "UC-09.2\nDự báo cung – cầu nguồn lực" as U2
}
RM -- U1
RM -- U2
U1 -- PM
U1 ..> U2 : <<include>>
@enduml
