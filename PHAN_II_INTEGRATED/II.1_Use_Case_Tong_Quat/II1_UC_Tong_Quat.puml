@startuml II1_UC_Tong_Quat
!pragma layout smetana
' II.1 - So do ca su dung tong quat
' Nguon: Phan I (I.1.2 "Tham gia tai", I.1.3.1), HD-PCCN muc 1 (ma va ten UC-01..UC-09)
' Chi ve 9 UC cap vung; UC chi tiet (UC-0x.y) ve o UCD cap vung trong II.2.
' Khong co include/extend giua cac UC cap vung: quan he giua cac vung la ban giao du lieu (I.1.3.1), khong phai goi hanh vi.
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle default
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam shadowing false
skinparam defaultFontName Arial

actor "PM\n(Quản lý dự án)" as PM
actor "RM\n(Quản lý nguồn lực)" as RM
actor "Nguồn lực" as NL
actor "Tài chính" as TC
actor "PMO/Quản lý danh mục" as PMO
actor "CEO/Managing Director" as CEO

rectangle "Hệ thống quản lý và điều phối nguồn lực dự án - Lạc Việt Consulting" {
  usecase "UC-01\nXác định nhu cầu nguồn lực" as UC01
  usecase "UC-02\nĐánh giá năng lực nguồn lực" as UC02
  usecase "UC-03\nTìm kiếm và đánh giá\nmức độ phù hợp" as UC03
  usecase "UC-04\nĐánh giá khả năng tham gia" as UC04
  usecase "UC-05\nLập phương án bố trí nguồn lực" as UC05
  usecase "UC-06\nXử lý xung đột và\ncân đối nguồn lực" as UC06
  usecase "UC-07\nRà soát và phê duyệt phương án" as UC07
  usecase "UC-08\nĐánh giá tác động\nchi phí và ngân sách" as UC08
  usecase "UC-09\nTheo dõi và dự báo nguồn lực" as UC09
}

' PM: V2, V5, V6, V7, V9, V10
PM -- UC01
PM -- UC04
PM -- UC05
PM -- UC06
PM -- UC08
PM -- UC09
' RM: V2 den V8, V10
RM -- UC01
RM -- UC02
RM -- UC03
RM -- UC04
RM -- UC05
RM -- UC06
RM -- UC07
RM -- UC09
' Nguon luc: V3
UC02 -- NL
' Tai chinh: V9
UC08 -- TC
' PMO: V3, V5, V7, V8, V9
UC02 -- PMO
UC04 -- PMO
UC06 -- PMO
UC07 -- PMO
UC08 -- PMO
' CEO: V5, V7, V8, V9
UC04 -- CEO
UC06 -- CEO
UC07 -- CEO
UC08 -- CEO
@enduml
