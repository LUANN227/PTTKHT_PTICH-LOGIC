width="26" height="26" as="geometry"/></mxCell><mxCell id="n10" value="1. Chọn phương án bố trí cần đánh giá chi phí, ghi lý do" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="135" y="157" width="250" height="54" as="geometry"/></mxCell><mxCell id="n11" value="Có phương án và phạm vi công việc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1145" y="239" width="210" height="90" as="geometry"/></mxCell><mxCell id="n12" value="E2. Không bắt đầu đánh giá" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1460" y="257" width="200" height="54" as="geometry"/></mxCell><mxCell id="n13" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1546" y="355" width="28" height="28" as="geometry"/></mxCell><mxCell id="n14" value="2. Hiển thị phương án, phạm vi công việc, nhân sự, số lượng, thời gian, mức độ tham gia" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1115" y="367" width="270" height="54" as="geometry"/></mxCell><mxCell id="n15" value="3. Lượng hóa, xác nhận yếu tố tạo chi phí: nhân sự, số lượng, thời gian, mức độ tham gia" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="110" y="467" width="300" height="54" as="geometry"/></mxCell><mxCell id="n16" value="4. Cung cấp, cập nhật đơn giá; ghi nhận chi phí thực tế nếu đã phát sinh" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="520" y="567" width="260" height="54" as="geometry"/></mxCell><mxCell id="n17" value="Đủ đơn giá và dữ liệu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="545" y="659" width="210" height="90" as="geometry"/></mxCell><mxCell id="n18" value="E1. Đánh dấu dữ liệu thiếu, yêu cầu Tài chính bổ sung; chưa kết luận chính thức" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1370" y="677" width="260" height="54" as="geometry"/></mxCell><mxCell id="n19" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1486" y="775" width="28" height="28" as="geometry"/></mxCell><mxCell id="n20" value="Có thay đổi hoặc lệch dự toán?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="545" y="779" width="210" height="90" as="geometry"/></mxCell><mxCell id="n21" value="A1. Tính lại phần chi phí bị ảnh hưởng, cập nhật dự báo" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="850" y="797" width="220" height="54" as="geometry"/></mxCell><mxCell id="n22" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="632" y="916" width="36" height="36" as="geometry"/></mxCell><mxCell id="n23" value="5. Tính chi phí dự toán; cập nhật dự báo, lưu tách dự toán và dự báo" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="520" y="997" width="260" height="54" as="geometry"/></mxCell><mxCell id="n24" value="6. Xem kết quả chi phí dự toán, dự báo của phương án" style="rounded=1;arcSi