<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-07.1" name="AD UC-07.1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;AD UC-07.1 Rà soát và đánh giá phương án&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1480" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;PMO/Quản lý danh mục&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="600" height="34" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="600" height="1180" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Cấp thẩm quyền (PMO Mức 1–3 / CEO Mức 4–5)&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="620" y="44" width="460" height="34" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="620" y="78" width="460" height="1180" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1080" y="44" width="420" height="34" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="78" width="420" height="1180" as="geometry"/></mxCell><mxCell id="n9" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="147" y="96" width="26" height="26" as="geometry"/></mxCell><mxCell id="n10" value="1. Tiếp nhận hồ sơ phương án gửi trình duyệt từ V6 hoặc V7" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="35" y="157" width="250" height="54" as="geometry"/></mxCell><mxCell id="n11" value="2. Đối chiếu mức rủi ro với ma trận DoA, xác định cấp thẩm quyền" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1150" y="257" width="280" height="54" as="geometry"/></mxCell><mxCell id="n12" value="Mức rủi ro?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="55" y="339" width="210" height="90" as="geometry"/></mxCell><mxCell id="n13" value="A1. Chuyển cấp hồ sơ lên CEO/Managing Director trong tối đa 1 ngày làm việc" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="360" y="357" width="220" height="54" as="geometry"/></mxCell><mxCell id="n14" value="A1. CEO/Managing Director tiếp nhận hồ sơ chuyển cấp" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="725" y="457" width="250" height="54" as="geometry"/></mxCell><mxCell id="n15" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="832" y="556" width="36" height="36" as="geometry"/></mxCell><mxCell id="n16" value="3. Rà soát tính hợp lý: phân bổ nhân sự, mức đáp ứng năng lực, tỷ lệ tải trọng, điểm xung đột" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="690" y="637" width="320" height="54" as="geometry"/></mxCell><mxCell id="n17" value="4. Cung cấp thông tin chi phí, chênh lệch ngân sách (V9) và cung – cầu, kết quả dự báo (V10)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="737" width="300" height="54" as="geometry"/></mxCell><mxCell id="n18" value="5. Đánh giá rủi ro, kết luận hồ sơ đủ hay chưa đủ cơ sở ra quyết định" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="700" y="837" width="300" height="54" as="geometry"/></mxCell><mxCell id="n19" value="Đủ cơ sở ra quyết định?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="745" y="929" width="210" height="90" as="geometry"/></mxCell><mxCell id="n20" value="6. Ghi nhận kết quả rà soát, chuyển hồ sơ sang UC-07.3 hoặc UC-07.4" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1150" y="947" width="280" height="54" as="geometry"/></mxCell><mxCell id="n21" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1276" y="1050" width="28" height="28" as="geometry"/></mxCell><mxCell id="n22" value="A2. Lập danh sách nội dung cần giải trình, bổ sung; chuyển UC-07.2" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="700" y="1062" width="300" height="54" as="geometry"/></mxCell><mxCell id="n23" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="836" y="1155" width="28" height="28" as="geometry"