<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-02.1" name="AD UC-02.1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;AD UC-02.1 Quản lý tiêu chí đánh giá năng lực&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1340" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;RM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="440" height="34" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="440" height="1220" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="460" y="44" width="600" height="34" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="460" y="78" width="600" height="1220" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;PMO/Quản lý danh mục&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1060" y="44" width="300" height="34" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1060" y="78" width="300" height="1220" as="geometry"/></mxCell><mxCell id="n9" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="227" y="96" width="26" height="26" as="geometry"/></mxCell><mxCell id="n10" value="1. Yêu cầu quản lý tiêu chí đánh giá năng lực" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="115" y="142" width="250" height="54" as="geometry"/></mxCell><mxCell id="n11" value="2. Cung cấp bộ tiêu chí hiện hành: kỹ năng, tiêu chí, thang 5 mức, điều kiện" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="495" y="142" width="270" height="54" as="geometry"/></mxCell><mxCell id="n12" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="222" y="241" width="36" height="36" as="geometry"/></mxCell><mxCell id="n13" value="3. Xác định nội dung thay đổi" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="115" y="297" width="250" height="54" as="geometry"/></mxCell><mxCell id="n14" value="Kỹ năng chưa có tiêu chí?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="135" y="379" width="210" height="90" as="geometry"/></mxCell><mxCell id="n15" value="A3. Ghi tiêu chí tạm ở trạng thái chờ phê duyệt" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="795" y="397" width="230" height="54" as="geometry"/></mxCell><mxCell id="n16" value="A3. Phê duyệt hoặc từ chối tiêu chí tạm" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1090" y="397" width="240" height="54" as="geometry"/></mxCell><mxCell id="n17" value="" style="ellipse;htm