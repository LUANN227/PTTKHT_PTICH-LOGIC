<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-03.3" name="AD UC-03.3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;AD UC-03.3 Đánh giá, xếp hạng và lập shortlist ứng viên&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1340" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;RM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="440" height="34" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="440" height="1600" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="460" y="44" width="600" height="34" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="460" y="78" width="600" height="1600" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;PMO/Quản lý danh mục&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1060" y="44" width="300" height="34" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1060" y="78" width="300" height="1600" as="geometry"/></mxCell><mxCell id="n9" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="227" y="96" width="26" height="26" as="geometry"/></mxCell><mxCell id="n10" value="1. Chọn nhu cầu đã xác nhận và danh sách ứng viên cần đánh giá" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="115" y="147" width="250" height="54" as="geometry"/></mxCell><mxCell id="n11" value="Đủ tiền điều kiện?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="565" y="129" width="210" height="90" as="geometry"/></mxCell><mxCell id="n12" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="961" y="160" width="28" height="28" as="geometry"/></mxCell><mxCell id="n13" value="2. Trình bày nhu cầu, ứng viên, điều kiện bắt buộc, tiêu chí, trọng số, năng lực từ hồ sơ tập trung" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="525" y="262" width="290" height="54" as="geometry"/></mxCell><mxCell id="n14" value="3. Đối chiếu điều kiện bắt buộc; loại ứng viên xung đột lợi ích (A1)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="105" y="362" width="270" height="54" as="geometry"/></mxCell><mxCell id="n15" value="4. Ghi phân loại và lý do không đạt; cảnh báo kỹ năng chưa xác nhận hoặc quá hạn (A3)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="525" y="462" width="290" height="54" as="geometry"/></mxCell><mxCell id="n16" value="Cần miễn trừ ứng viên?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="135" y="554" width="210" height="90" as="geometry"/></mxCell><mxCell id="n17" value="A2. Ghi đề nghị miễn trừ kèm lý do" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="115" y="687" width="250" height="54" as="geometry"/></mxCell><mxCell id="n18" value="A2. Phê duyệt hoặc từ chối đề nghị miễn trừ" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1090" y="687" width="240" height="54" as="geometry"/></mxCell><mxCell id="n19" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="652" y="796" width="36" height="36" as="geometry"/></mxCell><mxCell id="n20" value="Còn ứng viên đủ điều kiện?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="565" y="859" width="210" height="90" as="geometry"/></mxCell><mxCell id="n21" value="E3. Lưu phân loại, lý do loại; không lập shortlist (RM tìm tiếp ở UC-03.2)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="820" y="877" width="230" height="54" as="geometry"/></mxCell><mxCell id="n22" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="921" y="980" width="28" height="28" as="geometry"/></mxCell><mxCell id="n23" value="6. Chấm điểm từng tiêu chí cho ứng viên đủ điều kiện" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="115" y="997" width="250" height="54" as="geometry"/></mxCell><mxCell id="n24" value="7. Tính điểm tổng theo trọng số; xếp hạng; đồng hạng theo thứ tự ưu tiên nguồn (A4)" style="ro