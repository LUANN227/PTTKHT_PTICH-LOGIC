<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-01.1" name="AD UC-01.1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;AD UC-01.1 Xây dựng và hoàn thiện nhu cầu&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="780" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;PM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="400" height="34" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="400" height="1170" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="420" y="44" width="380" height="34" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="78" width="380" height="1170" as="geometry"/></mxCell><mxCell id="n7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="207" y="96" width="26" height="26" as="geometry"/></mxCell><mxCell id="n8" value="1. Chọn dự án; xem bối cảnh, công việc, kế hoạch giai đoạn" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="95" y="142" width="250" height="54" as="geometry"/></mxCell><mxCell id="n9" value="2. Hiển thị thông tin dự án, công việc và các mốc thời gian" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="485" y="142" width="250" height="54" as="geometry"/></mxCell><mxCell id="n10" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="202" y="231" width="36" height="36" as="geometry"/></mxCell><mxCell id="n11" value="3. Xác lập phạm vi công việc cần nguồn lực" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="95" y="287" width="250" height="54" as="geometry"/></mxCell><mxCell id="n12" value="4. Kiểm tra thông tin dự án và phạm vi" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="485" y="287" width="250" height="54" as="geometry"/></mxCell><mxCell id="n13" value="Đủ để hiểu công việc, giai đoạn, thời gian?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="505" y="369" width="210" height="90" as="geometry"/></mxCell><mxCell id="n14" value="A1. Yêu cầu bổ sung thông tin dự án hoặc điều chỉnh phạm vi; nhu cầu chưa cố định" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="387" width="260" height="54" as="geometry"/></mxCell><mxCell id="n15" value="5. Xác định loại nguồn lực, yêu cầu chuyên môn, kỹ năng cho từng công việc" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="85" y="497" width="270" height="54" as="geometry"/></mxCell><mxCell id="n16" value="6. Xác định quy mô FTE theo từng giai đoạn" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="95" y="582" width="250" height="54" as="geometry"/></mxCell><mxCell id="n17" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="202" y="661" width="36" height="36" as="geometry"/></mxCell><mxCell id="n18" value="7. Xác định thời gian hoặc giai đoạn và mức tham gia %FTE của từng vị trí" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="85" y="717" width="270" height="54" as="geometry"/></mxCell><mxCell id="n19" value="Thời gian và %FTE hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="505" y="699" width="210" height="90" as="geometry"/></mxCell><mxCell id="n20" value="8. Rà soát toàn bộ nhu cầu và lưu" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="95" y="837" width="250" height="54" as="geometry"/></mxCell><mxCell id="n21" value="9. Lưu nhu cầu, trạng thái “Đang xây dựng”" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="485" y="837" width="250" height="54" as="geometry"/></mxCell><mxCell id="n22" value="Nhu cầu đã hoàn thiện, chuyển RM?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="115" y="929" width="210" height="90" as="geometry"/></mxCell><mxCell id="n23" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="66" y="1050" width="28" height="28" as="geometry"/></mxCell><mxCell id="n24" value="10. Chuyển nhu cầu đã hoàn t