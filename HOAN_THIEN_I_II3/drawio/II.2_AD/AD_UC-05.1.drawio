<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-05.1" name="AD UC-05.1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;AD UC-05.1 Xây dựng phương án bố trí&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1160" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;RM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="700" height="34" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="700" height="1690" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="720" y="44" width="460" height="34" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="78" width="460" height="1690" as="geometry"/></mxCell><mxCell id="n7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="197" y="96" width="26" height="26" as="geometry"/></mxCell><mxCell id="n8" value="Bắt đầu từ phản hồi điều chỉnh của PM (UC-05.2)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="65" y="144" width="290" height="90" as="geometry"/></mxCell><mxCell id="n9" value="1. Tiếp nhận nhu cầu đã xác nhận và ứng viên còn khả năng tham gia; xác định vị trí cần bố trí" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="75" y="267" width="270" height="54" as="geometry"/></mxCell><mxCell id="n10" value="2. Hiển thị theo vị trí: nhu cầu, ứng viên, kết luận khả năng tham gia (V5)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="810" y="267" width="280" height="54" as="geometry"/></mxCell><mxCell id="n11" value="3. Tra cứu hồ sơ năng lực, mức sử dụng, lịch phân bổ, nguồn cung còn lại" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="75" y="387" width="270" height="54" as="geometry"/></mxCell><mxCell id="n12" value="4. Cung cấp thông tin; so sánh mức phù hợp, mức sử dụng, chi phí khi nhiều ứng viên đạt" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="810" y="387" width="280" height="54" as="geometry"/></mxCell><mxCell id="n13" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="192" y="471" width="36" height="36" as="geometry"/></mxCell><mxCell id="n14" value="Có ứng viên đáp ứng đầy đủ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="105" y="534" width="210" height="90" as="geometry"/></mxCell><mxCell id="n15" value="A3. Lập phương án “chấp nhận một phần”, ghi mức thiếu hụt" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="420" y="552" width="260" height="54" as="geometry"/></mxCell><mxCell id="n16" value="5. Xây dựng phương án chính: chọn người, vai trò, tỷ lệ, thời gian theo giai đoạn" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="75" y="662" width="270" height="54" as="geometry"/></mxCell><mxCell id="n17" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="192" y="761" width="36" height="36" as="geometry"/></mxCell><mxCell id="n18" value="6. Lưu phương án, trạng thái “đang xây dựng” (bắt đầu tính hạn 3 ngày làm việc)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="810" y="832" width="280" height="54" as="geometry"/></mxCell><mxCell id="n19" value="7. Nhận biết vị trí rủi ro cao (chỉ một ứng viên đạt)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="810" y="922" width="280" height="54" as="geometry"/></mxCell><mxCell id="n20" value="Có vị trí chỉ một ứng viên đạt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="105" y="994" width="210" height="90" as="geometry"/></mxCell><mxCell id="n21" value="Dự án gấp, chưa đủ thời gian?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="105" y="1104" width="210" height="90" as="geometry"/></mxCell><mxCell id="n22" value="A2. Lập phương án chính duy nhất, ghi lý do và cảnh báo rủi ro" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="420" y="1122" width="260" height="54" as="geometry"/></mxCell><mxCell id="n23" value="8. Lập phương án thay thế hoặc biện pháp giảm thiểu rủi ro" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="75" y="1222" width="270" height="54" as="geometry"/></mxCell><mxCell id="n24" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="192" y="1321" width="36" height="36" as="geometry"/></mxCell><mxCell id="n25" value="Quá 3 ngày làm việc ở “đang xây dựng”?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="85" y="1384" width="250" height="90" as="geometry"/></mxCell><mxCell id="n26" value="E1. Ghi lý do, báo cáo PMO" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="435" y="1402" width="230" height="54" as="geometry"/></mxCell><mxCell id="n27" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="192" y="1501" width="36" height="36" as="geometry"/></mxCell><mxCell id="n28" value="9. Gửi phương án bố trí (chính và thay thế) cho PM xem xét" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="75" y="1572" width="270" height="54" as="geometry"/></mxCell><mxCell id="n29" value="10. Ghi nhận việc gửi, chuyển phương án cho PM (sang UC-05.2)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="810" y="1572" width="280" height="54" as="geometry"/></mxCell><mxCell id="n30" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="936" y="1675" width="28" height="28" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow