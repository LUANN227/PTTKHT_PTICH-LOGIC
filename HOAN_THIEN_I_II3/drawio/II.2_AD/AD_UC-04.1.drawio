<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-04.1" name="AD UC-04.1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;AD UC-04.1 Đánh giá khả năng tham gia&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1240" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;RM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="640" height="34" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="640" height="1520" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="660" y="44" width="600" height="34" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="78" width="600" height="1520" as="geometry"/></mxCell><mxCell id="n7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="167" y="96" width="26" height="26" as="geometry"/></mxCell><mxCell id="n8" value="1. Tiếp nhận yêu cầu nguồn lực, khung thời gian và shortlist từ V4" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="45" y="147" width="270" height="54" as="geometry"/></mxCell><mxCell id="n9" value="Yêu cầu gấp, thời hạn dưới 24–48 giờ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="65" y="229" width="230" height="90" as="geometry"/></mxCell><mxCell id="n10" value="A6. Đánh giá nhanh theo phân bổ cứng, ghi nhận rủi ro, tiếp tục theo dõi" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="375" y="247" width="250" height="54" as="geometry"/></mxCell><mxCell id="n11" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="486" y="340" width="28" height="28" as="geometry"/></mxCell><mxCell id="n12" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="162" y="386" width="36" height="36" as="geometry"/></mxCell><mxCell id="n13" value="2. Kiểm tra đầu vào: yêu cầu, khung thời gian, shortlist" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="705" y="377" width="250" height="54" as="geometry"/></mxCell><mxCell id="n14" value="Đủ thông tin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="725" y="459" width="210" height="90" as="geometry"/></mxCell><mxCell id="n15" value="A1. Yêu cầu bổ sung, xác nhận thông tin; chưa kết luận" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="375" y="477" width="250" height="54" as="geometry"/></mxCell><mxCell id="n16" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="812" y="576" width="36" height="36" as="geometry"/></mxCell><mxCell id="n17" value="3. Tra cứu năng lực chuẩn, lịch, nghỉ, phân bổ cứng và mềm của ứng viên; kiểm tra độ mới" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="695" y="637" width="270" height="54" as="geometry"/></mxCell><mxCell id="n18" value="Dữ liệu đủ rõ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="75" y="719" width="210" height="90" as="geometry"/></mxCell><mxCell id="n19" value="A2. Gắn nhãn “dữ liệu chưa đủ rõ”" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="375" y="737" width="250" height="54" as="geometry"/></mxCell><mxCell id="n20" value="Chờ xác nhận?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="395" y="824" width="210" height="90" as="geometry"/></mxCell><mxCell id="n21" value="A2. Đặt chờ xác nhận trong 2 ngày làm việc" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="995" y="842" width="230" height="54" as="geometry"/></mxCell><mxCell id="n22" value="A2. Coi như chưa có dữ liệu, gửi yêu cầu xác nhận ngay" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="705" y="942" width="250" height="54" as="geometry"/></mxCell><mxCell id="n23" value="4. Xác định năng lực khả dụng thực tế: năng lực chuẩn trừ nghỉ, không tính phí, phân bổ cứng" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="45" y="842" width="270" height="54" as="geometry"/></mxCell><mxCell id="n24" value="5. Đối chiếu mức sử dụng với 70–85%; trên 85% xem phần chờ xác nhận; trên 90% liên tục trên 2 tuần gắn cờ Mức 2" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="942" width="280" height="54" as="geometry"/></mxCell><mxCell id="n25" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="812" y="1036" width="36" height="36" as="geometry"/></mxCell><mxCell id="n26" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="162" y="1036" width="36" height="36" as="geometry"/></mxCell><mxCell id="n27" value="6. Ghi nhận kết luận theo bốn trạng thái kèm căn cứ (dữ liệu chưa rõ: chờ xác nhận)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="1102" width="280" height="54" as="geometry"/></mxCell><mxCell id="n28" value="7. Lưu kết luận và căn cứ của ứng viên" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="705" y="1102" width="250" height="54" as="geometry"/></mxCell><mxCell id="n29" value="Còn ứng viên cần đánh giá?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="725" y="1184" width="210" height="90" as="geometry"/></mxCell><mxCell id="n30" value="8. Tổng hợp kết luận của từng ứng viên, bàn giao" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="55" y="1302" width="250" height="54" as="geometry"/></mxCell><mxCell id="n31" value="9. Chuyển theo kết luận: đầy đủ → V6 (cờ Mức 2 kèm sang V6, V10); một phần → UC-04.2 (A4); vượt tải ngoại lệ → UC-04.3 (A5); trùng phân bổ cứng → V7 (A3)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="690" y="1402" width="320" height="54" as="geometry"/></mxCell><mxCell id="n32" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="836" y="1505" width="28" height="28" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="[Có]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n9" target="n10"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="[Không]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" par