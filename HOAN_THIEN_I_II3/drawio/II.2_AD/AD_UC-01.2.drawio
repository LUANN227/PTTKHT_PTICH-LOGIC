<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-01.2" name="AD UC-01.2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;AD UC-01.2 Xác nhận nhu cầu&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="940" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;RM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="560" height="34" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="560" height="830" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="580" y="44" width="380" height="34" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="580" y="78" width="380" height="830" as="geometry"/></mxCell><mxCell id="n7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="157" y="96" width="26" height="26" as="geometry"/></mxCell><mxCell id="n8" value="1. Tiếp nhận nhu cầu nguồn lực đã hoàn thiện cần xem xét" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="45" y="142" width="250" height="54" as="geometry"/></mxCell><mxCell id="n9" value="2. Hiển thị thông tin nhu cầu nguồn lực" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="645" y="142" width="250" height="54" as="geometry"/></mxCell><mxCell id="n10" value="3. Xem xét nhu cầu, đánh giá mức đáp ứng điều kiện xác nhận" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="45" y="247" width="250" height="54" as="geometry"/></mxCell><mxCell id="n11" value="Nhu cầu đủ điều kiện?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="65" y="329" width="210" height="90" as="geometry"/></mxCell><mxCell id="n12" value="A1. Ghi nhận nội dung cần bổ sung, điều chỉnh" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="325" y="347" width="230" height="54" as="geometry"/></mxCell><mxCell id="n13" value="A1. Chuyển lại nhu cầu cho PM, trạng thái “Cần tiếp tục hoàn thiện” (PM xử lý ở UC-01.3)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="635" y="347" width="270" height="54" as="geometry"/></mxCell><mxCell id="n14" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="756" y="450" width="28" height="28" as="geometry"/></mxCell><mxCell id="n15" value="4. Xác nhận nhu cầu đủ điều kiện" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="45" y="537" width="250" height="54" as="geometry"/></mxCell><mxCell id="n16" value="5. Ghi nhận kết quả, cập nhật trạng thái “Đã xác nhận”" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="645" y="537" width="250" height="54" as="geometry"/></mxCell><mxCell id="n17" value="6. Bàn giao nhu cầu đã xác nhận cho V3 và V4" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="45" y="647" width="250" height="54" as="geometry"/></mxCell><mxCell id="n18" value="7. Chuyển nhu cầu “Đã xác nhận” sang V3 và V4" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="645" y="757" width="250" height="54" as="geometry"/></mxCell><mxCell id="n19" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="756" y="860" width="28" height="28" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n8" target="n9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n9" target="n10"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="274"/></Array></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=ort