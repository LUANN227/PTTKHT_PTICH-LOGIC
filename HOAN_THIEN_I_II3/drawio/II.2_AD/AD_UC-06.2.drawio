<mxfile host="ad_lib.py" type="device"><diagram id="AD UC-06.2" name="AD UC-06.2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;AD UC-06.2 Cân đối nguồn lực&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1500" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;RM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="700" height="34" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="700" height="1340" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;PM&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="720" y="44" width="380" height="34" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="78" width="380" height="1340" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Hệ thống&lt;/b&gt;" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1100" y="44" width="420" height="34" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1100" y="78" width="420" height="1340" as="geometry"/></mxCell><mxCell id="n9" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="187" y="96" width="26" height="26" as="geometry"/></mxCell><mxCell id="n10" value="1. Chọn điểm xung đột cần cân đối (từ UC-06.1); mở phiên đàm phán" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="65" y="147" width="270" height="54" as="geometry"/></mxCell><mxCell id="n11" value="Mức 3 trở lên?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="95" y="229" width="210" height="90" as="geometry"/></mxCell><mxCell id="n12" value="E1. Chỉ ghi nhận để theo dõi" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="425" y="247" width="230" height="54" as="geometry"/></mxCell><mxCell id="n13" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="526" y="340" width="28" height="28" as="geometry"/></mxCell><mxCell id="n14" value="2. Hiển thị điểm xung đột, kịch bản, đường găng, khoảng dự trữ, xếp hạng danh mục; theo dõi hạn 3 ngày làm việc" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1160" y="367" width="300" height="54" as="geometry"/></mxCell><mxCell id="n15" value="3. Đàm phán chia sẻ, thay thế hoặc điều chỉnh nhu cầu nguồn lực" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="775" y="467" width="270" height="54" as="geometry"/></mxCell><mxCell id="n16" value="Kết quả đàm phán?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="95" y="549" width="210" height="90" as="geometry"/></mxCell><mxCell id="n17" value="A1. Quá 3 ngày làm việc hoặc bế tắc: chuyển hồ sơ sang UC-06.3" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="415" y="567" width="250" height="54" as="geometry"/></mxCell><mxCell id="n18" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="526" y="660" width="28" height="28" as="geometry"/></mxCell><mxCell id="n19" value="4. Ghi nhận phương án được thống nhất" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="75" y="677" width="250" height="54" as="geometry"/></mxCell><mxCell id="n20" value="Còn khoảng dự trữ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="95" y="759" width="210" height="90" as="geometry"/></mxCell><mxCell id="n21" value="Bế tắc hoàn toàn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="435" y="759" width="210" height="90" as="geometry"/></mxCell><mxCell id="n22" value="A3. RM và PM lập đề xuất lùi mốc tiến độ gốc hoặc cắt giảm phạm vi" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="775" y="777" width="270" height="54" as="geometry"/></mxCell><mxCell id="n23" value="5. Làm mịn: điều chỉnh thời điểm trong khoảng dự trữ, không đổi ngày hoàn thành" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="65" y="887" width="270" height="54" as="geometry"/></mxCell><mxCell id="n24" value="A2. San bằng nguồn lực trong hạn mức công suất" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillCo