        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam ActivityBackgroundColor #FFFFFF\nskinparam ActivityBorderColor #000000\nskinparam ArrowColor #000000\nskinparam swimlaneTitleFontStyle bold\nskinparam swimlaneWidth same\nskinparam wrapWidth 180\nskinparam NoteBackgroundColor #FFFFFF\nskinparam NoteBorderColor #000000\n\ntitle UC-08.1 Đánh giá tác động chi phí và ngân sách của phương án bố trí nguồn lực\n\n|PM|\n|Tài chính|\n|Hệ thống|\n|PM|\nstart\n:Chọn phương án;\n\n|Hệ thống|\n:Kiểm tra tiền điều kiện;\nif () then ([không đủ tiền điều kiện\\nhoặc không có quyền])\n  stop\n  note right: Kết thúc E2\nelse ([đủ])\nendif\n\n:Trình bày yếu tố chi phí;\n\n|PM|\n:Xác nhận yếu tố chi phí;\n\n|Tài chính|\n:Cập nhật/xác nhận đơn giá,\\nghi nhận chi phí thực tế;\nif () then ([thiếu đơn giá\\nhoặc dữ liệu])\n  |Hệ thống|\n  :Đánh dấu dữ liệu thiếu;\n  stop\n  note right: Kết thúc E1\nelse ([đủ])\nendif\n\n|Hệ thống|\nif () then ([có thay đổi hoặc\\nchi phí thực tế lệch])\n  :Tính lại, cập nhật dự báo;\nelse ([không có])\nendif\n\n:Xác định dự toán;\n:Đối chiếu ngân sách,\\nxác định chênh lệch, trạng thái;\n\nif () then ([vượt ngân sách còn lại])\n  |PM|\n  :Ghi nguyên nhân vượt\\n(PM + Tài chính);\n  |Hệ thống|\n  if () then ([vượt ≤ 10%])\n    :Gắn cấp Quản lý danh mục;\n  else ([vượt &gt; 10%])\n    :Gắn cấp CEO/MD;\n  endif\nelse ([không vượt])\nendif\n\nif () then ([từ hai phương án trở lên])\n  :So sánh theo chất lượng,\\nchi phí, thời gian;\nelse ([một phương án])\nendif\n\n|PM|\n:Ghi nhận hướng xử lý;\n\n|Hệ thống|\n:Lưu kết quả,\\ncung cấp cho V8 và V10;\nstop\nnote right: Kết thúc chính\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MfH1Nx7hweszkIMH0nlN-41">
